# --- Client (público, vai pro bundle do front-end) ---
# Config padrão do Firebase Web SDK: NÃO é segredo, pode ficar público.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server-only (variáveis de ambiente da Vercel, marcar como "Sensitive") ---
# Credenciais da service account usada pelo Admin SDK (gerar em
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Cole a private_key do JSON da service account. Mantenha os literais \n
# (não quebre em múltiplas linhas) — o código faz o replace para \n real.
FIREBASE_ADMIN_PRIVATE_KEY=

# Chave mestra de envelope encryption (gerar com: openssl rand -base64 32)
MASTER_KEK_BASE64=

# API key do Resend (resend.com)
RESEND_API_KEY=

# Remetente usado nos e-mails. Em sandbox (sem domínio verificado no Resend)
# use o default do próprio Resend, que só envia para o e-mail da sua conta:
MAIL_FROM="Amigo Secreto <onboarding@resend.dev>"

# URL pública de produção/staging do front-end (sem barra no final), usada
# para montar os links de convite/revelação embutidos nos e-mails.
APP_BASE_URL=https://seu-dominio.vercel.app

# Segredo compartilhado só com a Vercel, usado para autenticar chamadas aos
# endpoints /api/cron/* (gerar com: openssl rand -hex 32)
CRON_SECRET=
