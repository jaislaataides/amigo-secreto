{
  "rewrites": [
    { "source": "/api/parties/:path*", "destination": "/api/parties/router" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/purge-expired-parties", "schedule": "0 3 * * *" },
    { "path": "/api/cron/send-reminders", "schedule": "0 12 * * *" },
    { "path": "/api/cron/process-mail", "schedule": "0 18 * * *" }
  ]
}
