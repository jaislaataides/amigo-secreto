rules_version = '2';

// Path fixo por party: partyImages/{partyId}/cover.<ext>. Reupload sobrescreve
// o mesmo objeto (sem arquivos órfãos). Leitura pública de propósito — a capa
// precisa renderizar como <img> em e-mails transacionais, que não enviam o
// ID token do Firebase Auth ao buscar a imagem. Tudo sensível (assignments,
// tokens, dados de participantes) mora no Firestore, não no Storage, e já
// está 100% bloqueado lá (ver firestore.rules).
service firebase.storage {
  match /b/{bucket}/o {
    match /partyImages/{partyId}/cover.{ext} {
      allow read: if true;

      allow write: if request.auth != null
                   && ext.matches('jpe?g|png|webp')
                   && (request.auth.token.admin == true
                       || firestore.get(/databases/(default)/documents/parties/$(partyId)).data.ownerUid == request.auth.uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null
                    && (request.auth.token.admin == true
                        || firestore.get(/databases/(default)/documents/parties/$(partyId)).data.ownerUid == request.auth.uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
